rules_version = '2';

// Cualquiera con sesión anónima (los 4 amigos, vía la app) puede leer todo.
// Cada persona solo puede escribir su propio perfil y sus propios votos/comentarios,
// identificados por su uid de Firebase Auth anónimo.
service cloud.firestore {
  match /databases/{database}/documents {

    // Hilo de comentarios múltiples (playas, camperos y pelis): cada persona
    // puede crear los que quiera y solo borrar/editar los suyos.
    function isOwnComment() {
      return request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /beaches/{beachId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;

      match /ratings/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isOwnComment();
      }
    }

    match /camperos/{camperoId} {
      allow read: if true;
      allow create: if request.auth != null;
      // "update" solo se usa para rellenar lat/lng cuando la geolocalización
      // automática no se pudo hacer al crearlo (backfill silencioso).
      allow update: if request.auth != null;
      allow delete: if false;

      match /ratings/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isOwnComment();
      }
    }

    match /movies/{movieId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;

      match /ratings/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isOwnComment();
      }
    }

    match /days/{dayId} {
      allow read: if true;
      allow write: if request.auth != null;

      // Experiencias: varias por persona. Las antiguas tenían como id el uid
      // (sin campo uid), las nuevas llevan el campo uid.
      match /entries/{entryId} {
        allow read: if true;
        allow create: if request.auth != null
          && (entryId == request.auth.uid || request.resource.data.uid == request.auth.uid);
        allow update, delete: if request.auth != null
          && (entryId == request.auth.uid || resource.data.get('uid', null) == request.auth.uid);
      }
    }
  }
}
