rules_version = '2';

// Cualquiera con sesión anónima (los 4 amigos, vía la app) puede leer todo.
// Cada persona solo puede escribir su propio perfil y sus propios votos/comentarios,
// identificados por su uid de Firebase Auth anónimo.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /beaches/{beachId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;

      match /ratings/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /camperos/{camperoId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;

      match /ratings/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }

    match /days/{dayId} {
      allow read: if true;
      allow write: if request.auth != null;

      match /entries/{uid} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
